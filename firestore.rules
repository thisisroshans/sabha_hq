rules_version = '2';

// LIVE production rules for the org-scoped schema (see docs/saas-schema.md)
// — deployed to the sabha-hq project as part of the full SaaS cutover
// (2026-08-07). The Flutter app reads/writes these org-scoped paths
// (task #9) and every server-side write is backed by a Cloud Function.
// Changes here need the same care as any other prod change: verify
// against the Firestore emulator (functions/scripts/_test-firestore-rules.js,
// `npm run test:rules`) before `firebase deploy --only firestore:rules`.
//
// The holes this replaced (see git history for the pre-migration
// version of this file):
//   1. isAdmin() used to mean "signed in with email/password" full stop —
//      no org check at all. Any admin, any org, could read/write/delete
//      any event, anywhere.
//   2. isGuestSession() let any anonymous check-in session (from ANY
//      event's check-in link) read every event's attendee list, because
//      the rule never looked at which event the session belonged to.
//   3. (Closed by task #6) Any active guest session could write directly
//      to attendees — search, check in, register a walk-in — with no
//      server-side validation, dedup, rate limiting, or audit trail.
//      Those writes now go exclusively through the checkIn/registerWalkIn
//      callables (functions/src/checkIn.ts); a guest session's Firestore
//      access is read-only.
//
// Fix for #1: isOrgMember()/isOwnerOrAdmin() check request.auth.token.orgId
// against the specific org being accessed (custom claims set by
// functions/src/invites.ts on invite-accept, or by
// functions/scripts/migrate-to-orgs.js for the bootstrap owner).
//
// Fix for #2: isGuestSessionFor(orgId, eventId) requires BOTH to match —
// not just "some anonymous session", but specifically one that
// functions/src/guestSessions.ts's beginGuestSession stamped with this
// exact event. Proven in functions/scripts/_test-firestore-rules.js: a
// guest session bound to event A cannot read event B's attendees even
// within the SAME org, let alone a different one.
//
// ---------------------------------------------------------------------
// PLATFORM DASHBOARD (Sabha HQ's own ops dashboard, not any customer's) —
// see functions/src/platform.ts and lib/features/platform/.
//
// platformRole is a claim on Sabha HQ staff accounts, structurally
// SEPARATE from {orgId, role} — a platform-staff account belongs to no
// org and cannot inherit any org's data access through isOrgMember().
// Only 'owner' exists today; a lesser 'support' tier (usage/limits
// visibility without full org data) is anticipated but not built.
//
// isPlatformOwner() is added ONLY to READ rules, giving Sabha HQ's owner
// the same read visibility into every org that org's own owner/admin has
// — not write access, and not the ability to act as the org (that's
// impersonation, deliberately not built — see the SaaS platform plan).
// orgs/{orgId}.limits/.status/.plan are excluded from the org's own
// update rule (see below) and are writable only via Admin SDK
// (functions/src/platform.ts), so every change to them is guaranteed to
// go through platformAuditLog — there is no direct-write path to bypass
// that trail, for the platform owner or the org itself.
//
// orgIsActive(orgId) blocks WRITES (not reads) once a platform owner sets
// status:'suspended' — reads stay open so a suspended org's own admin UI
// can still show a clear "you're suspended" banner instead of a wall of
// permission-denied errors.
// ---------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function isOrgMember(orgId) {
      return request.auth != null && request.auth.token.orgId == orgId;
    }

    function isOwnerOrAdmin(orgId) {
      return isOrgMember(orgId) &&
        (request.auth.token.role == 'owner' || request.auth.token.role == 'admin');
    }

    function isGuestSessionFor(orgId, eventId) {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider == 'anonymous' &&
        request.auth.token.guestOrgId == orgId &&
        request.auth.token.guestEventId == eventId;
    }

    function isPlatformOwner() {
      return request.auth != null && request.auth.token.platformRole == 'owner';
    }

    // Treats an org with no status field yet (every org created before
    // this feature existed) as active — suspension is opt-in via an
    // explicit platform action, never a side effect of the field being
    // unset. Costs one extra document read per write this guards; a
    // normal, accepted tradeoff for a cross-document business rule check
    // rules can't otherwise express.
    function orgIsActive(orgId) {
      let org = get(/databases/$(database)/documents/orgs/$(orgId)).data;
      return !('status' in org) || org.status != 'suspended';
    }

    // Defense-in-depth for the denormalised orgId field (see
    // firestore_refs.dart's class comment): every legitimate write already
    // sets it to the org the client is actually scoped to, so this never
    // blocks a real write — it only blocks a forged/corrupted one. Without
    // it, an org member could write an attendee doc under their OWN path
    // but tag it with a DIFFERENT org's id, silently skewing that org's
    // usage/billing count (functions/src/platform.ts's usageForOrg() does
    // collectionGroup('attendees').where('orgId', '==', orgId)) without
    // ever touching that org's own data directly.
    function attendeeDataValid(orgId) {
      return request.resource.data.orgId == orgId;
    }

    // Guest-submitted feedback (isGuestSessionFor, not just org members) is
    // the most adversarial write surface in this file — anyone who's ever
    // checked into an event can hit it, with no server-side validation
    // (task #6 only moved check-in to a callable, not feedback; see the
    // comment on the feedback match block below). rating is a 1-5 star
    // score in the UI; comment is optional. eventId is deliberately NOT
    // checked here — firestore_refs.dart's feedback converter strips it
    // before writing, so the field never exists on the stored doc.
    function feedbackDataValid() {
      return (request.resource.data.rating is int || request.resource.data.rating is float) &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        (request.resource.data.comment == null || request.resource.data.comment is string);
    }

    match /orgs/{orgId} {
      allow read: if isOrgMember(orgId) || isPlatformOwner();
      // The org's own owner/admin can rename it etc., but NOT touch
      // limits/status/plan — those are platform-controlled fields, sent
      // through functions/src/platform.ts only, so every change is
      // audit-logged. Without this exclusion, an org could just write
      // {status: 'active', limits: {...raised...}} directly and the
      // whole platform dashboard would be theater.
      allow update: if isOwnerOrAdmin(orgId) && orgIsActive(orgId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['limits', 'status', 'plan']);
      // Still no CLIENT-side org creation/deletion — self-serve creation
      // exists now (functions/src/orgs.ts's createOrg, task #7) but runs
      // as the Admin SDK, which bypasses rules entirely, same as
      // migrate-to-orgs.js's bootstrap path. Deletion has no flow at all
      // yet and shouldn't be a rules-only decision.
      allow create, delete: if false;

      match /members/{uid} {
        // Any member can see who else is on the team; the platform owner
        // can see every org's team, same as that org's own owner can.
        allow read: if isOrgMember(orgId) || isPlatformOwner();
        // No client write path exists — acceptInviteHandler
        // (functions/src/invites.ts) creates this doc via the Admin SDK,
        // which enforces the seat limit (limits.maxTeamMembers) and the
        // invite-token flow before writing, then bypasses rules entirely.
        // A client-write rule here, even scoped to owner/admin, would let
        // any admin create member docs — including granting themselves
        // role:'owner' — straight past both of those checks. Closed
        // outright rather than "kept sane for later": write the real rule
        // (with field-level protection on `role`, same pattern as
        // orgs/{orgId}'s limits/status/plan exclusion below) if a client
        // write path is ever actually built.
        allow write: if false;

        // Push-notification devices — one doc per FCM token, written by
        // the app itself (lib/core/notifications/check_in_notifications.dart)
        // and read only by functions/src/notifications.ts (Admin SDK) to
        // push every check-in to the org's owners/admins. A separate
        // subcollection precisely so the member doc above can stay fully
        // locked: registering a phone must never be a way to touch `role`.
        //
        // Strictly self-service: a member can register/remove only their
        // OWN devices (uid == request.auth.uid), never a teammate's — so
        // nobody can point someone else's notifications at a device they
        // control. Not gated on orgIsActive(): it's device bookkeeping,
        // not org data, and logging out of a suspended org must still be
        // able to remove the device. No client reads — nothing in the app
        // needs to list devices.
        match /devices/{token} {
          allow create, update: if isOrgMember(orgId) && request.auth.uid == uid &&
            request.resource.data.keys().hasOnly(['platform', 'updatedAt']) &&
            request.resource.data.platform in ['android', 'ios', 'web'];
          allow delete: if isOrgMember(orgId) && request.auth.uid == uid;
          allow read: if false;
        }
      }

      match /invites/{token} {
        // createInvite/acceptInvite (functions/src/invites.ts) both use
        // the Admin SDK, which bypasses rules — no client reads or writes
        // this collection today, including the platform owner: an org's
        // own owner can't read these either, so this isn't a gap in
        // "view everything an org owner can see" — it's parity.
        allow read, write: if false;
      }

      match /events/{eventId} {
        // Event details (title/date/location/branding) are needed by the
        // public check-in screen before any auth completes, and carry no
        // PII — same reasoning as the pre-migration rules, just scoped
        // under the org path now.
        allow read: if true;
        // create moved to the createEvent callable (functions/src/events.ts)
        // — it needs to run a count() aggregation to enforce maxEvents,
        // which rules can't express (get() reads one document; there's no
        // rules equivalent of counting a subcollection). update/delete
        // don't need a quantity check, so they stay direct client writes.
        allow create: if false;
        allow update, delete: if isOwnerOrAdmin(orgId) && orgIsActive(orgId);

        match /attendees/{attendeeId} {
          // Any org member (owner/admin/staff) can see and manage
          // attendees; a guest session may only READ the one event it
          // was bound to by beginGuestSession — this is the fix for hole
          // #2 above. Platform owner reads everything, same as any org's
          // own owner/admin can.
          //
          // Guests do NOT get create/update here (fix for hole #3): the
          // kiosk's search/check-in/walk-in writes go through the
          // checkIn/registerWalkIn callables (functions/src/checkIn.ts),
          // which run as the Admin SDK and so bypass these rules
          // entirely — they don't need a client-write allowance to work.
          // Only org members write attendees directly now (CSV import,
          // manual add/edit in the admin guest list).
          allow read: if isOrgMember(orgId) || isGuestSessionFor(orgId, eventId) || isPlatformOwner();
          allow create, update: if isOrgMember(orgId) && orgIsActive(orgId) && attendeeDataValid(orgId);
          // Deleting an attendee record is destructive enough to reserve
          // for owner/admin — staff can check people in, not erase them.
          allow delete: if isOwnerOrAdmin(orgId) && orgIsActive(orgId);
        }

        match /feedback/{feedbackId} {
          // Not moved server-side by task #6 (in scope for that task was
          // check-in, not feedback) — direct guest writes, same
          // isGuestSessionFor(orgId, eventId) scoping as check-in used to
          // have before that task. The /feedback screen itself (task #8)
          // calls ensureGuestSession the same way check-in does, so this
          // works the same way for the same reason.
          allow read: if isOwnerOrAdmin(orgId) || isPlatformOwner();
          allow create: if (isOrgMember(orgId) || isGuestSessionFor(orgId, eventId)) && orgIsActive(orgId) && feedbackDataValid();
          allow update, delete: if isOwnerOrAdmin(orgId) && orgIsActive(orgId);
        }

        match /scheduleItems/{itemId} {
          // The agenda (task #8) — same reasoning as event details: no
          // PII, needed pre-auth so a guest can see "what's happening
          // now" without checking in first. Only owner/admin manage it.
          allow read: if true;
          allow create, update, delete: if isOwnerOrAdmin(orgId) && orgIsActive(orgId);
        }

        // checkIn.ts's own bookkeeping — rate-limit counters and the
        // audit log it writes on every attempt. Both written exclusively
        // by the Admin SDK (bypasses rules); no UI reads either today,
        // including the platform owner — an org's own owner can't read
        // these either, so leaving this closed is parity, not a gap.
        // Explicit deny here rather than relying silently on the
        // catch-all at the bottom, so a future "show me the check-in
        // audit log" screen has to consciously open this up rather than
        // finding it already readable by accident.
        match /checkInRateLimits/{uid} {
          allow read, write: if false;
        }
        match /checkInLog/{logId} {
          allow read, write: if false;
        }
      }
    }

    // Sabha HQ's own audit trail of platform-owner actions (limit
    // changes, suspensions) — functions/src/platform.ts writes every
    // entry via the Admin SDK. No client write path exists, so every
    // entry here is guaranteed to have gone through a logged function
    // call, not a forgeable direct write.
    match /platformAuditLog/{logId} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    // Deny everything else by default — including the legacy flat
    // events/{eventId}/... tree the migration script copies FROM but
    // deliberately never deletes. No client should touch that legacy data
    // once the app cuts over (task #9); an operator can still inspect or
    // delete it via the Admin SDK/console, which always bypasses rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
